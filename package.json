{
  "name": "total-krieg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive WWII European theatre map: territorial changes, orders of battle and commanders (1939-1945)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:base": "python3 scripts/build_base.py && node scripts/build_topo.mjs base",
    "data:territory": "python3 scripts/build_territories.py && node scripts/build_topo.mjs territories",
    "data:relief": "node scripts/build_relief.mjs && python3 scripts/build_relief.py",
    "data:places": "python3 scripts/build_places.py",
    "data:portraits": "python3 scripts/fetch_portraits.py"
  },
  "dependencies": {
    "d3-ease": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-timer": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-timer": "^3.0.2",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "topojson-server": "^3.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
